# ---- colcon / ROS 2 build artifacts ----
/build/
/install/
/log/

# NOTE: src/ is VENDORED (committed) — the workspace source lives in the repo.

# ---- crash dumps ----
core.*

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# ---- media source files (keep the small web-friendly derivatives, not the raw exports) ----
# The README embeds the compressed video/*.mp4; the large raw .mov exports stay local.
video/*.mov

# ---- crazyflie firmware TOC caches ----
# cflib also writes a cache/ directory of per-firmware param/log TOC JSON into
# the working directory (cache/<firmware-hash>.json). Same story as the csv
# files below: regenerated on connect, per-firmware, never read by this repo.
# It WAS tracked until 2026-10-09 (docs/ARCHITECTURE.md flagged it).
/cache/

# crazyflie_server writes these into the working directory on connect (the
# param/log table-of-contents of whatever firmware it just talked to). They are
# regenerated every run and are per-firmware, so they are cache, not source.
# Anywhere, not just the repo root: two of them were committed into
# src/crazyswarm2/crazyflie/config/ in 2026-10-02 and installed into the
# package share, where nothing read them.
log*.csv
params*.csv

# Claude Code session transcripts dropped into the working directory.
*-this-session-is-being-continued-from-a-previous-*.txt

# ---- editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
