uint8 trajectory_id
uint32 piece_offset
TrajectoryPolynomialPiece[] pieces
---
# An upload can fail without the link dying: a drone starved by the upload
# itself can stop answering (measured 2026-10-05: "Sent: 1487. Received: 0"),
# and the firmware's own 1 s radio-activity timeout flushes the response.
# Without these fields a show flies a trajectory the drone never received.
bool success
string message
